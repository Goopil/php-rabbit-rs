{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "goopil/rabbit-rs-native",
    "type": "php-ext",
    "description": "High-performance RabbitMQ transport for PHP and Laravel, powered by Rust",
    "license": "MIT",
    "homepage": "https://github.com/Goopil/php-rabbit-rs",
    "authors": [
        {
            "name": "Zachary Volpi",
            "email": "hello@zvolpi.ch"
        }
    ],
    "keywords": ["rabbitmq", "amqp", "laravel", "queue", "rust"],
    "require": {
        "php": "^8.4"
    },
    "php-ext": {
        "extension-name": "rabbit_rs",
        "priority": 80,
        "support-zts": false,
        "support-nts": true,
        "os-families": ["linux", "darwin"],
        "download-url-method": ["pre-packaged-binary"]
    }
}
