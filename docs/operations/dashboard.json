{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Rabbit RS — v1 observability",
  "description": "Minimal dashboard for the documented external-collection model (v1 ships no exporter): per-process Pool::stats() fields via the sidecar polling `php artisan rabbit-rs:status --format=json` (exposed as rabbit_rs_<field>), plus RabbitMQ broker gauges (rabbitmq_* from the RabbitMQ Prometheus plugin — requires the management metrics collector ENABLED; fresh queues can lag or omit gauges). Playbooks: docs/operations/runbook.md; alert rules: docs/operations/alerts.md.",
  "tags": ["rabbit-rs", "rabbitmq"],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "queue",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(rabbitmq_queue_messages, queue)",
        "refresh": 2,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Dropped publications (any instance = data-loss bug, page)",
      "description": "Pool::stats() dropped_publications_total, summed across worker instances. Non-zero after confirmed-path acceptance is a data-loss bug by contract.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(rabbit_rs_dropped_publications_total[$__rate_interval]))",
          "legendFormat": "dropped"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Publish buffer occupancy (must quiesce to 0 when idle)",
      "description": "publish_buffered (publications parked) and publish_buffered_bytes. A plateau while idle is a re-buffer leak or confirm stall.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rabbit_rs_publish_buffered)",
          "legendFormat": "buffered (count)"
        },
        {
          "expr": "sum(rabbit_rs_publish_buffered_bytes)",
          "legendFormat": "buffered (bytes)"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Backpressure events (producers hitting the bounded budget)",
      "description": "backpressure_total per process; sum across instances.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(rabbit_rs_backpressure_total[$__rate_interval]))",
          "legendFormat": "backpressure"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Reconnects (recoveries per instance)",
      "description": "reconnects_total per worker instance — keep them separated to localize the storm.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (instance) (increase(rabbit_rs_reconnects_total[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Settlement latency percentiles (ms)",
      "description": "settlement_latency_p95/p99 from Pool::stats().",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "max(rabbit_rs_settlement_latency_p95)", "legendFormat": "p95" },
        { "expr": "max(rabbit_rs_settlement_latency_p99)", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Duplicates (per-process exact) vs broker redeliveries (approximate)",
      "description": "Left: duplicates_total summed across workers (deliveries the broker flagged as redeliveries that this process settled). Right: management-API messages_redelivered — APPROXIMATE cross-process signal, also counts crash requeues and stale-ACK redeliveries; correlate, never alert on it alone.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(rabbit_rs_duplicates_total[$__rate_interval]))",
          "legendFormat": "duplicates (process-exact)"
        },
        {
          "expr": "sum(increase(rabbitmq_queue_messages_redelivered_total{queue=~\"$queue\"}[$__rate_interval]))",
          "legendFormat": "redelivered (broker, approximate)"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Queue depth (broker)",
      "description": "rabbitmq_queue_messages per queue. Requires the management metrics collector ENABLED; fresh queues can lag or omit the gauge until the first stats sample.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=~\"$queue\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Broker availability",
      "description": "Scrape health of the RabbitMQ nodes.",
      "type": "stat",
      "gridPos": { "h": 3, "w": 6, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "min(up{job=\"rabbitmq\"})", "legendFormat": "up" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Confirmation latency p99 (ms)",
      "description": "confirmation_latency_p99 from Pool::stats(); sustained growth pairs with backpressure (broker saturation).",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "max(rabbit_rs_confirmation_latency_p99)", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    }
  ]
}
