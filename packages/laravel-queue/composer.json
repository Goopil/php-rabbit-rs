{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "goopil/rabbit-rs-laravel",
    "description": "Laravel queue driver for the Rabbit RS native extension",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-rabbit_rs": "^0.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Goopil\\RabbitRs\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goopil\\RabbitRs\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Goopil\\RabbitRs\\Laravel\\RabbitMqServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}