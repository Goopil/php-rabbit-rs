{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "goopil/rabbit-rs-laravel",
    "description": "Laravel queue driver for the Rabbit RS native extension",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/process": "^7.2 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Goopil\\RabbitRs\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goopil\\RabbitRs\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Goopil\\RabbitRs\\Laravel\\RabbitMqServiceProvider"
            ]
        }
    },
    "suggest": {
        "ext-rabbit_rs": "Required to dispatch and consume jobs (^0.3.1). composer install succeeds without it; connections fail at resolution time until the native extension is loaded (pie install goopil/rabbit-rs-native).",
        "laravel/horizon": "Required to use the Horizon dashboard integration (worker=horizon)"
    },
    "scripts": {
        "analyse": "phpstan --no-progress",
        "lint": "pint --test",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
