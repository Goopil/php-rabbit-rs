APP_NAME="Rabbit RS Runtime"
APP_ENV=local
APP_KEY=base64:xjU1Aez6VElD5YzCBHSx3pGJ6RVGFLm5p6TJ0DBcpv0=
APP_DEBUG=true
APP_URL=http://127.0.0.1

# The minimal app has no database: keep session/cache handlers in-process.
SESSION_DRIVER=array
CACHE_STORE=array

OCTANE_SERVER=roadrunner

RABBIT_RS_CONNECTION=rabbit-rs
RABBIT_RS_HOSTS=127.0.0.1:5672
RABBIT_RS_VHOST=/orders-eu
RABBIT_RS_USERNAME=rabbit_rs
RABBIT_RS_PASSWORD=rabbit_rs_lab
RABBIT_RS_QUEUE=rabbit-rs.octane-certification
# Exchange name must match the lab permission regex (^rabbit-rs\.): the
# default (`laravel.jobs`) is refused for the rabbit_rs user at declare time.
RABBIT_RS_EXCHANGE=rabbit-rs.jobs
RABBIT_RS_FLUSH_INTERVAL=60000
