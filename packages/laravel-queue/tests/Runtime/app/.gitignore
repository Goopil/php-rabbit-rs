/vendor
/node_modules
/.env
# RoadRunner binary staged here by the harness (octane spawns it from the app
# base path); the pinned copy lives in target/rr-bin/rr.
/rr
# Regenerated by octane at start (RoadRunner config, FrankenPHP worker script).
/.rr.yaml
/public/frankenphp-worker.php
# Crash dumps from SIGKILLed server processes land here (cwd of octane:start).
/core
/core.*
/storage
/bootstrap/cache
# The certification environment must be reproducible: the lock is committed
# and refreshed deliberately (same policy as the digest-pinned FrankenPHP
# image). Re-certifying against a newer Octane = regenerate this file.
!/composer.lock
