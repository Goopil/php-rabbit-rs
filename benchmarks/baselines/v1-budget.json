    },
    "ffi_conversion": {
      "message_construction_256B_ns":    { "measured": 163,  "target_max": 250 },
      "message_construction_1KiB_ns":   { "measured": 189,  "target_max": 300 },
      "message_construction_10KiB_ns":  { "measured": 304,  "target_max": 500 },
      "message_construction_1MiB_ns":   { "measured": 19100, "target_max": 25000 },
      "header_conversion_0_ns":        { "measured": 3,    "target_max": 50 },
