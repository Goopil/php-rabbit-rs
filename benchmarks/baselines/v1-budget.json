        "batch_size": 64,
        "measured_mib_s": 972.2,
        "target_mib_s_min": 900
      },
      "1KiB": {
        "batch_size": 16,
        "measured_mib_s": 446.4,
        "target_mib_s_min": 400
      },
      "10KiB": {
        "batch_size": 1,
        "measured_mib_s": 524.1,
        "target_mib_s_min": 480
      },
      "100KiB": {
        "batch_size": 64,
        "measured_gib_s": 21.2,
        "target_gib_s_min": 18
      },
      "1MiB": {
        "batch_size": 256,
        "measured_gib_s": 37.5,
        "target_gib_s_min": 30
      }
    },
    "batch_per_message_latency_ns": {
      "256B_batch256": { "measured": 1042, "target_max": 1200 },
      "1KiB_batch256": { "measured": 1076, "target_max": 1300 }
