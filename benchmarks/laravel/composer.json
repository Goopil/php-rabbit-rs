{
    "name": "rabbit-rs/bench-laravel",
    "description": "Reproducible Laravel queue comparison lab for rabbit-rs vs other drivers",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "php-amqplib/php-amqplib": "^3.7",
        "predis/predis": "^2.0",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^15.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Drivers\\": "drivers/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
