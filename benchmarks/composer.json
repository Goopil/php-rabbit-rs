{
    "name": "rabbit-rs/benchmarks",
    "description": "Standalone PHP benchmarks for rabbit-rs",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "php-amqplib/php-amqplib": "^3.7",
        "bunny/bunny": "^0.5",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^15.0",
        "illuminate/container": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/config": "^12.0 || ^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../packages/laravel-queue",
            "options": {"symlink": true}
        }
    ],
    "autoload": {
        "psr-4": {
            "Bench\\": "src/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^5.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
