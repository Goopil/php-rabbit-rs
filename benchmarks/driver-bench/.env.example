APP_NAME=driver-bench
APP_ENV=local
APP_KEY=
APP_DEBUG=true
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# rabbit-rs (goopil/rabbit-rs-laravel) — native ext-rabbit_rs driver
# Fairness vhost: "/" with user rabbit_rs (configure grant ^(amq\.|bench\.|benchmark_))
# Exchange: empty = AMQP default exchange (direct-to-queue, Phase A parity)
# ---------------------------------------------------------------------------
RABBIT_RS_HOSTS=127.0.0.1:5672
RABBIT_RS_VHOST=/
RABBIT_RS_USERNAME=rabbit_rs
RABBIT_RS_PASSWORD=rabbit_rs_lab
RABBIT_RS_EXCHANGE=
RABBIT_RS_QUEUE=bench.goopil.driver-bench
RABBIT_RS_PREFETCH=64
RABBIT_RS_SAFETY=safe
RABBIT_RS_WORKER=default
# Pop blocking window in seconds (worker-style). 0 = non-blocking pop
# (bench default; the runner handles in-flight stragglers itself).
RABBIT_RS_BLOCK_FOR=0

# ---------------------------------------------------------------------------
# vladimir-yuldashev/laravel-queue-rabbitmq — php-amqplib driver
# Fairness vhost: "/orders-eu" with user admin (full grants)
# Exchange: driver default = AMQP default exchange (queue auto-declared on
# first push). prefetch_count only applies to the queue:work subscribe path,
# not to bench pop() (basic_get), so it is not set here.
# ---------------------------------------------------------------------------
VLADIMIR_HOST=127.0.0.1
VLADIMIR_PORT=5672
VLADIMIR_VHOST=/orders-eu
VLADIMIR_LOGIN=admin
VLADIMIR_PASSWORD=admin_lab
VLADIMIR_QUEUE=bench.vladimir.driver-bench

# ---------------------------------------------------------------------------
# iamfarhad/laravel-rabbitmq — ext-amqp driver (Docker only)
# Fairness vhost: "/billing" with user admin (full grants)
# Exchange: driver default = AMQP default exchange. prefetch applies to
# consume mode only; bench pop() uses basic_get (poll mode).
# Publisher confirms variant: IAMFARHAD_PUBLISHER_CONFIRMS=true (+_MANDATORY)
# ---------------------------------------------------------------------------
IAMFARHAD_HOST=127.0.0.1
IAMFARHAD_PORT=5672
IAMFARHAD_VHOST=/billing
IAMFARHAD_USERNAME=admin
IAMFARHAD_PASSWORD=admin_lab
IAMFARHAD_QUEUE=bench.iamfarhad.driver-bench
IAMFARHAD_PREFETCH=64
IAMFARHAD_CONNECTION_NAME=driver-bench-rabbitmq-ext
